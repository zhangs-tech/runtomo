# Google OAuth Web Client ID (must match server GOOGLE_WEB_CLIENT_ID)
runtomo.googleWebClientId=your-google-web-client-id.apps.googleusercontent.com

# Backend API base URL for debug builds
# Run `adb reverse tcp:8080 tcp:8080` so that localhost on the emulator or device reaches the local server.
# Do not use http://10.0.2.2:8080/. Android 17 blocks local network addresses for this app.
runtomo.apiBaseUrl=http://localhost:8080/
