# Google OAuth Web Client ID (must match server GOOGLE_WEB_CLIENT_ID)
runtomo.googleWebClientId=your-google-web-client-id.apps.googleusercontent.com

# Backend API base URL
# Use http://10.0.2.2:8080/ for the Android emulator, or http://localhost:8080/ with `adb reverse tcp:8080 tcp:8080`
runtomo.apiBaseUrl=http://10.0.2.2:8080/
