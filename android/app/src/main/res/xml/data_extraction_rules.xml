<?xml version="1.0" encoding="utf-8"?>
<!--
Auth tokens belong to one device. A restored refresh token would sign in a second device.
The player cache belongs to the signed-in Player, and the server holds the real data.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/auth_tokens.preferences_pb" />
        <exclude domain="file" path="datastore/player_cache.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth_tokens.preferences_pb" />
        <exclude domain="file" path="datastore/player_cache.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
