%% RunTomo MVP ERD (derived from docs/usecases)
%% Not stored as tables: mood (UC-10, computed), leaderboards (UC-16, from DAILY_STATS),
%% bond level thresholds, reward tiers, caps, stride and other tunable values (server config).
%% Every local_date is a UTC+7 day (docs/usecases/README.md, Days).
erDiagram
    %% ---------- Accounts & social ----------
    USERS {
        uuid id PK
        string auth_provider "google only in the MVP (UC-01 BR-4)"
        string auth_subject UK "Google sub claim, not email (UC-01 BR-6), unique with auth_provider"
        string display_name "3-20 chars, not unique"
        string friend_code UK "created at sign-up (UC-01 BR-2)"
        bigint coin_balance "cache of COIN_TRANSACTIONS"
        uuid equipped_tomo_id FK "own Tomo only (UC-11), null until the starter exists (UC-02)"
        timestamp created_at
    }

    REFRESH_TOKENS {
        uuid id PK
        uuid user_id FK
        uuid family_id "one per sign-in, reuse revokes the whole family"
        string token_hash UK "hash only, never the raw token"
        uuid replaced_by_id FK "set on refresh, a replaced token sent again is reuse"
        timestamp expires_at "30 days, tunable (UC-01 BR-7)"
        timestamp revoked_at "sign-out, refresh or reuse"
        timestamp created_at
    }

    FRIEND_REQUESTS {
        uuid id PK
        uuid from_user_id FK
        uuid to_user_id FK
        string status "pending, accepted, declined, one pending per pair (UC-15)"
        timestamp created_at
    }

    FRIENDSHIPS {
        uuid user_a_id PK, FK "user_a_id < user_b_id"
        uuid user_b_id PK, FK
        timestamp created_at
    }

    %% ---------- Tomos ----------
    SPECIES {
        uuid id PK
        string code UK
        string name
        string rarity "common..legendary"
        bool is_starter
        bool in_gacha_pool
    }

    SKINS {
        uuid id PK
        uuid species_id FK
        string name
        string rarity
        bool is_default "MVP: default only"
    }

    USER_TOMOS {
        uuid id PK "unique with user_id, for ownership FKs"
        uuid user_id FK
        uuid species_id FK
        uuid skin_id FK "skin of the same species"
        string nickname "1-16 chars"
        int bond_points
        int bond_level "1-10, thresholds in config (UC-05 BR-4)"
        bigint distance_together_m
        date birthday "date the Player got it (UC-02 BR-3)"
    }

    %% ---------- Daily activity ----------
    DAILY_STATS {
        uuid user_id PK, FK
        date local_date PK "UTC+7 day"
        int steps "today's total from Health Connect, only goes up"
        int distance_m "steps times stride from config"
        int activity_coins "coins paid for this day, for the daily cap"
        int bond_points "Bond paid for this day"
        timestamp synced_at "last sync"
    }

    %% ---------- Currency ----------
    COIN_TRANSACTIONS {
        uuid id PK
        uuid user_id FK
        int amount "+ earn / - spend"
        string reason "activity, quest, achievement, summon, duplicate, food"
        uuid ref_id "source row, unique with reason except food, null for activity and achievement"
        timestamp created_at
    }

    %% ---------- Gacha ----------
    BANNERS {
        uuid id PK
        string name
        int cost_coins
        int pity_threshold "20"
        timestamp starts_at
        timestamp ends_at "null = standard"
    }

    BANNER_RATES {
        uuid banner_id PK, FK
        string rarity PK
        float rate
    }

    BANNER_SPECIES {
        uuid banner_id PK, FK
        uuid species_id PK, FK
    }

    USER_PITY {
        uuid user_id PK, FK
        uuid banner_id PK, FK
        int pulls_since_epic
    }

    SUMMONS {
        uuid id PK
        uuid user_id FK
        uuid banner_id FK
        uuid species_id FK
        string rarity
        int cost_coins
        bool was_pity
        bool was_duplicate
        uuid user_tomo_id FK "null if duplicate"
        timestamp created_at
    }

    %% ---------- Quests & achievements ----------
    QUEST_DEFINITIONS {
        uuid id PK
        string code UK
        string title
        string metric "distance_m, steps"
        int target
        int reward_coins
        bool active
    }

    USER_DAILY_QUESTS {
        uuid id PK
        uuid user_id FK
        uuid quest_id FK
        date local_date "UTC+7, UK with user_id, quest_id"
        int progress
        timestamp completed_at
        timestamp claimed_at "auto-claimed later if the day ends first (UC-13 4a)"
    }

    ACHIEVEMENT_DEFINITIONS {
        uuid id PK
        string code UK
        string name
        string metric "total distance, days with 1 km, distance together, species owned"
        float target
        int reward_coins
    }

    USER_ACHIEVEMENTS {
        uuid user_id PK, FK
        uuid achievement_id PK, FK
        timestamp unlocked_at
    }

    %% ---------- Feeding (Should) ----------
    FOOD_ITEMS {
        uuid id PK
        string name
        int cost_coins
        int bond_points
    }

    USER_FOOD_INVENTORY {
        uuid user_id PK, FK
        uuid food_item_id PK, FK
        int quantity
    }

    FEEDINGS {
        uuid id PK
        uuid user_tomo_id FK
        uuid food_item_id FK
        date local_date "UTC+7, max 3 per tomo per day"
        timestamp fed_at
    }

    %% ---------- Relationships ----------
    USERS ||--o{ REFRESH_TOKENS : "signs in with"
    REFRESH_TOKENS |o--o| REFRESH_TOKENS : "replaced by"

    USERS ||--o{ USER_TOMOS : owns
    USERS |o--o| USER_TOMOS : equips
    SPECIES ||--o{ USER_TOMOS : "is species of"
    SPECIES ||--|{ SKINS : has
    SKINS ||--o{ USER_TOMOS : wears

    USERS ||--o{ FRIEND_REQUESTS : sends
    USERS ||--o{ FRIEND_REQUESTS : receives
    USERS ||--o{ FRIENDSHIPS : "is user_a"
    USERS ||--o{ FRIENDSHIPS : "is user_b"

    USERS ||--o{ DAILY_STATS : syncs

    USERS ||--o{ COIN_TRANSACTIONS : ledger

    BANNERS ||--|{ BANNER_RATES : defines
    BANNERS ||--|{ BANNER_SPECIES : pools
    SPECIES ||--o{ BANNER_SPECIES : "appears in"
    USERS ||--o{ USER_PITY : tracks
    BANNERS ||--o{ USER_PITY : "counted for"
    USERS ||--o{ SUMMONS : performs
    BANNERS ||--o{ SUMMONS : "rolled on"
    SPECIES ||--o{ SUMMONS : result
    SUMMONS |o--o| USER_TOMOS : creates

    QUEST_DEFINITIONS ||--o{ USER_DAILY_QUESTS : "instantiated as"
    USERS ||--o{ USER_DAILY_QUESTS : has
    ACHIEVEMENT_DEFINITIONS ||--o{ USER_ACHIEVEMENTS : "unlocked as"
    USERS ||--o{ USER_ACHIEVEMENTS : unlocks

    FOOD_ITEMS ||--o{ USER_FOOD_INVENTORY : stocked
    USERS ||--o{ USER_FOOD_INVENTORY : holds
    USER_TOMOS ||--o{ FEEDINGS : "is fed"
    FOOD_ITEMS ||--o{ FEEDINGS : used
