# PostgreSQL (Docker Compose listens on port 5433)
POSTGRES_DB=runtomo
POSTGRES_USER=runtomo
POSTGRES_PASSWORD=changeme
POSTGRES_URL=jdbc:postgresql://localhost:5433/runtomo

# Google OAuth Web Client ID (must match Android runtomo.googleWebClientId)
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# RSA key pair for JWT signing and verification
JWT_PUBLIC_KEY=file:keys/app.pub
JWT_PRIVATE_KEY=file:keys/app.key
